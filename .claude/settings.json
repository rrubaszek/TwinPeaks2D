{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(make)",
      "Bash(make release)",
      "Bash(make clean)",
      "Bash(make CC=:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(valgrind:*)",
      "Bash(perf stat:*)",
      "Bash(perf report:*)"
    ],
    "ask": [
      "Edit",
      "Write",
      "Bash(make run)",
      "Bash(./twin_peaks:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
